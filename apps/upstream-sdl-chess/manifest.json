{
  "name": "SDL Chess Board",
  "identifier": "SDLCHESS",
  "executable": "CHESS.APP",
  "abi_version": 1,
  "data_namespace": "SDLCHESS",
  "memory_limit": 67108864,
  "max_handles": 8,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write",
    "time",
    "window",
    "input"
  ]
}
