{
  "name": "Phipia Native Network Client",
  "identifier": "NETAPP",
  "executable": "NETAPP.APP",
  "data_namespace": "NETAPP",
  "memory_limit": 33554432,
  "max_handles": 24,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write",
    "time",
    "network"
  ],
  "arguments": ["http://phipia.test/welcome.txt"]
}
